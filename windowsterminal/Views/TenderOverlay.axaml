<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MerchantTerminal.ViewModels"
             xmlns:m="using:MerchantTerminal.Models"
             x:Class="MerchantTerminal.Views.TenderOverlay"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="70,*" Background="{DynamicResource Bg}">

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="28,0">
                <Button DockPanel.Dock="Right" Classes="pos" Height="40" Padding="18,0"
                        VerticalAlignment="Center" Command="{Binding CloseOverlayCommand}">
                    <TextBlock Text="BACK TO BASKET" FontSize="12" LetterSpacing="1.2"
                               Foreground="{DynamicResource Dim}" />
                </Button>
                <TextBlock Classes="serif" Text="{Binding TenderTitle}" FontSize="27"
                           VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" ColumnDefinitions="*,520">

            <!-- Tender selection -->
            <Border Grid.Column="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0"
                    Padding="36,32">
                <StackPanel Spacing="18">
                    <TextBlock Classes="label" Text="SELECT TENDER" FontSize="10" LetterSpacing="2" />
                    <Grid ColumnDefinitions="*,14,*" RowDefinitions="104,14,104,14,104"
                          IsEnabled="{Binding TendersEnabled}">
                        <Button Grid.Row="0" Grid.Column="0" Classes="pos tile" Padding="22,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding TenderCardCommand}">
                            <StackPanel Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Credit / debit card" FontSize="18" FontWeight="Medium" />
                                <TextBlock Text="{Binding CardTileHint}" FontSize="12" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Classes="pos tile" Padding="22,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding TenderCircleCommand}">
                            <StackPanel Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Loyallist card" FontSize="18" FontWeight="Medium" />
                                <TextBlock Text="Loyalty account on file" FontSize="12" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Classes="pos tile" Padding="22,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding TenderCashCommand}">
                            <StackPanel Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Cash" FontSize="18" FontWeight="Medium" />
                                <TextBlock Text="Opens drawer" FontSize="12" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2" Classes="pos tile" Padding="22,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding TenderGiftCommand}">
                            <StackPanel Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Gift card" FontSize="18" FontWeight="Medium" />
                                <TextBlock Text="Balance enquiry available" FontSize="12" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="4" Grid.Column="0" Classes="pos tile" Padding="22,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding TenderSplitCommand}">
                            <StackPanel Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Split tender" FontSize="18" FontWeight="Medium" />
                                <TextBlock Text="Two or more methods" FontSize="12" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="4" Grid.Column="2" Classes="pos tile" Padding="22,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding TenderLinkCommand}">
                            <StackPanel Spacing="7" VerticalAlignment="Center">
                                <TextBlock Text="Pay by link" FontSize="18" FontWeight="Medium" />
                                <TextBlock Text="SMS to customer mobile" FontSize="12" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Awaiting customer terminal -->
                    <Border IsVisible="{Binding IsAwaitingTerminal}" BorderBrush="{DynamicResource Accent}"
                            BorderThickness="1" CornerRadius="10" Padding="16">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Classes="ghost" Height="36" Padding="16,0"
                                    VerticalAlignment="Center" Command="{Binding CancelTerminalCommand}">
                                <TextBlock Text="Cancel" FontSize="12" />
                            </Button>
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Awaiting customer terminal" FontSize="14"
                                           Foreground="{DynamicResource Accent}" />
                                <TextBlock Text="The customer is completing payment on the WinkPay terminal"
                                           FontSize="11.5" Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Amount pane -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}" Padding="36,32">
                <Grid RowDefinitions="Auto,*,Auto">
                    <StackPanel Grid.Row="0">
                        <TextBlock Classes="label" Text="AMOUNT TO COLLECT" FontSize="10" LetterSpacing="2" />
                        <TextBlock Classes="mono" Text="{Binding BalanceDisplay}" FontSize="60"
                                   FontWeight="SemiBold" LetterSpacing="-1.8" Margin="0,12,0,6" />
                        <TextBlock Text="{Binding TenderHint}" FontSize="13" Foreground="{DynamicResource Dim}" />
                        <Border Height="1" Background="{DynamicResource Line}" Margin="0,24" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1">
                        <ItemsControl ItemsSource="{Binding Payments}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Payment">
                                    <Border Background="{DynamicResource Panel2}"
                                            BorderBrush="{DynamicResource Line}" BorderThickness="1"
                                            CornerRadius="10" Padding="16,14">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Classes="mono"
                                                       Text="{Binding AmountDisplay}" FontSize="17"
                                                       Foreground="{DynamicResource Pos}" VerticalAlignment="Center" />
                                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Label}" FontSize="15" />
                                                <TextBlock Text="{Binding Detail}" FontSize="11.5"
                                                           Foreground="{DynamicResource Dim}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Spacing="12" Margin="0,18,0,0" IsVisible="{Binding IsSettled}">
                        <Border BorderBrush="{DynamicResource Pos}" BorderThickness="1" CornerRadius="10"
                                Padding="16">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="APPROVED" FontSize="11" LetterSpacing="1.3"
                                           Foreground="{DynamicResource Pos}" VerticalAlignment="Center" />
                                <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="Paid in full · change" FontSize="14"
                                               Foreground="{DynamicResource Pos}" />
                                    <TextBlock Classes="mono" Text="{Binding ChangeDisplay}" FontSize="14"
                                               Foreground="{DynamicResource Pos}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Button Classes="cta" Height="70" HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center" Command="{Binding FinishCommand}">
                            <TextBlock Text="Print &amp; email receipt · Finish" FontSize="18"
                                       FontWeight="SemiBold" LetterSpacing="0.7" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
