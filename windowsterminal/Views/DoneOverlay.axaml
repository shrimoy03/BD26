<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MerchantTerminal.ViewModels"
             x:Class="MerchantTerminal.Views.DoneOverlay"
             x:DataType="vm:MainViewModel">

    <Panel Background="{DynamicResource Bg}">
        <StackPanel Width="560" Spacing="18" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="avares://MerchantTerminal/Assets/rewards_dog.png" Height="130"
                   Stretch="Uniform" HorizontalAlignment="Center" />
            <Border Width="64" Height="64" CornerRadius="32" BorderBrush="{DynamicResource Pos}"
                    BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock Text="✓" FontSize="26" Foreground="{DynamicResource Pos}"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Classes="serif" Text="Sale complete" FontSize="40" LineHeight="44"
                       HorizontalAlignment="Center" />
            <TextBlock Text="{Binding DoneMessage}" FontSize="15" Foreground="{DynamicResource Dim}"
                       MaxWidth="420" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" />
            <Button Classes="cta" Height="64" Padding="42,0" Margin="0,14,0,0"
                    HorizontalAlignment="Center" Command="{Binding NewSaleCommand}">
                <TextBlock Text="Start next sale" FontSize="17" FontWeight="SemiBold" LetterSpacing="0.7" />
            </Button>
        </StackPanel>
    </Panel>
</UserControl>
