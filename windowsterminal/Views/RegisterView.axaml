<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MerchantTerminal.ViewModels"
             xmlns:m="using:MerchantTerminal.Models"
             x:Class="MerchantTerminal.Views.RegisterView"
             x:DataType="vm:MainViewModel"
             FontFamily="Tahoma, Geneva, Arial"
             Foreground="#141414">

    <!-- ============================================================
         Replica of the Bloomingdale's AYS register (BLM pos flow deck,
         build 2026.6.1_1112): left basket panel, right prompt panel,
         T1–T8 key grid, status bar. 1600×1000 fixed canvas.
         ============================================================ -->

    <UserControl.Styles>
        <Style Selector="TextBlock">
            <Setter Property="Foreground" Value="#141414" />
        </Style>
        <!-- Olive-green F-key legend text -->
        <Style Selector="TextBlock.legend">
            <Setter Property="Foreground" Value="#6E7B00" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Red advisory text -->
        <Style Selector="TextBlock.advise">
            <Setter Property="Foreground" Value="#BE2E20" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
        <!-- Prompt body text -->
        <Style Selector="TextBlock.prompt">
            <Setter Property="FontSize" Value="16.5" />
            <Setter Property="LineHeight" Value="23" />
        </Style>

        <!-- T-keys: dark red gradient tiles -->
        <Style Selector="Button.tkey">
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#3A0A10" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#A62D34" Offset="0" />
                        <GradientStop Color="#8A1E27" Offset="0.45" />
                        <GradientStop Color="#5F0F18" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
        <Style Selector="Button.tkey:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#B53A41" Offset="0" />
                        <GradientStop Color="#96262F" Offset="0.45" />
                        <GradientStop Color="#6B141D" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Function bar: the old F-key actions as real buttons, so the demo
             never needs a keyboard. The shortcuts still work. -->
        <Style Selector="Button.fkey">
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="#8A867A" />
            <Setter Property="Background" Value="#E7E2CD" />
            <Setter Property="Foreground" Value="#141414" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.fkey:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#F2EEDC" />
            <Setter Property="BorderBrush" Value="#8A1E27" />
        </Style>
        <Style Selector="Button.fkey:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#D6D0B8" />
        </Style>
        <Style Selector="Button.fkey:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#DAD6C4" />
            <Setter Property="Foreground" Value="#9A968A" />
        </Style>
        <Style Selector="Button.tkey:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background">
                <Setter.Value>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%">
                        <GradientStop Color="#5F0F18" Offset="0" />
                        <GradientStop Color="#8A1E27" Offset="1" />
                    </LinearGradientBrush>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="34,*,176,38,40" Background="#C9C4B2">

        <!-- ===== Title strip ===== -->
        <Border Grid.Row="0">
            <Border.Background>
                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,0%">
                    <GradientStop Color="#EFEDDF" Offset="0" />
                    <GradientStop Color="#EAE6D6" Offset="0.62" />
                    <GradientStop Color="#A8323A" Offset="0.86" />
                    <GradientStop Color="#7E1A24" Offset="1" />
                </LinearGradientBrush>
            </Border.Background>
            <DockPanel Margin="14,0,12,0">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="12"
                            VerticalAlignment="Center">
                    <Ellipse Width="13" Height="13" Fill="#2FA12F" Stroke="#1C6A1C" StrokeThickness="1" />
                    <TextBlock Text="Purchase" FontSize="16" FontWeight="Bold" />
                </StackPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding Build}" FontSize="12.5"
                           FontWeight="Bold" Foreground="#F4E8E8" VerticalAlignment="Center" />
                <Panel />
            </DockPanel>
        </Border>

        <!-- ===== Main area: basket + prompt panels ===== -->
        <Grid Grid.Row="1" Margin="10,6,10,6" ColumnDefinitions="56*,44*">

            <!-- ..... Left panel ..... -->
            <Border Grid.Column="0" Background="#FCFBF2" BorderBrush="#55534A" BorderThickness="1">
                <Panel>

                    <!-- Loyalty stage: the two Loyallist card faces -->
                    <StackPanel IsVisible="{Binding IsLoyaltyStage}" Spacing="52"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Bloomingdale's Loyallist credit card -->
                        <Border Width="268" Height="164" CornerRadius="10"
                                BorderBrush="#2E2850" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#6A5EBE" Offset="0" />
                                    <GradientStop Color="#4A3F98" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="16,12">
                                <TextBlock Text="bloomingdale's loyallist" FontSize="11"
                                           Foreground="#EDEAFF" HorizontalAlignment="Right" />
                                <TextBlock Text="bloom" FontSize="52" FontWeight="Bold" FontStyle="Italic"
                                           Foreground="#C9C2F2" VerticalAlignment="Center" Margin="0,4,0,0" />
                                <StackPanel VerticalAlignment="Bottom" Spacing="4">
                                    <TextBlock Text="00 000 000 000    0" FontSize="14"
                                               FontFamily="Courier New" Foreground="#F2F0FF" />
                                    <DockPanel>
                                        <TextBlock Text="B. BEST CUSTOMER" FontSize="9" Foreground="#D9D4F5" />
                                        <TextBlock Text="CARDHOLDER SINCE 2026" FontSize="7.5"
                                                   Foreground="#B9B2E5" HorizontalAlignment="Right" />
                                    </DockPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Loyallist key-tag card -->
                        <Border Width="268" Height="164" CornerRadius="10"
                                BorderBrush="#39325E" BorderThickness="1">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                                    <GradientStop Color="#8478CE" Offset="0" />
                                    <GradientStop Color="#5C50AC" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid Margin="16,12">
                                <TextBlock Text="POINTS ARE A SHOPPER'S BEST FRIEND" FontSize="8.5"
                                           Foreground="#EDEAFF" />
                                <TextBlock Text="bloom" FontSize="52" FontWeight="Bold" FontStyle="Italic"
                                           Foreground="#A79DE2" VerticalAlignment="Center" Margin="0,6,0,0" />
                                <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Right" Spacing="0">
                                    <TextBlock Text="Tell." FontSize="12" FontStyle="Italic" Foreground="#F2F0FF"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Text="loyallist" FontSize="13" FontWeight="Bold"
                                               Foreground="#F2F0FF" HorizontalAlignment="Right" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!-- Every later stage: the basket -->
                    <Grid IsVisible="{Binding ShowBasket}" RowDefinitions="Auto,*,Auto">

                        <!-- Customer / loyalty header -->
                        <Grid Grid.Row="0" IsVisible="{Binding CustomerLinked}" Margin="10,8,10,0"
                              ColumnDefinitions="*,Auto,*" Height="58">
                            <TextBlock Grid.Column="0" Text="{Binding CustomerName}" FontSize="17"
                                       FontWeight="Bold" VerticalAlignment="Top" />
                            <!-- tiny overlapping card art -->
                            <Panel Grid.Column="1" Width="86" Height="46" VerticalAlignment="Top">
                                <Border Width="62" Height="38" CornerRadius="4" Background="#5C50AC"
                                        BorderBrush="#39325E" BorderThickness="1" Margin="24,8,0,0"
                                        HorizontalAlignment="Left" VerticalAlignment="Top" />
                                <Border Width="62" Height="38" CornerRadius="4" Background="#6A5EBE"
                                        BorderBrush="#39325E" BorderThickness="1"
                                        HorizontalAlignment="Left" VerticalAlignment="Top">
                                    <TextBlock Text="bloom" FontSize="13" FontStyle="Italic" FontWeight="Bold"
                                               Foreground="#C9C2F2" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" />
                                </Border>
                            </Panel>
                            <TextBlock Grid.Column="2" Text="{Binding LoyaltyNumberDisplay}" FontSize="17"
                                       FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Top" />
                        </Grid>

                        <!-- Item lines (+ tender lines once paid) -->
                        <StackPanel Grid.Row="1" Margin="0,2,0,0">
                            <Border BorderBrush="#55534A" BorderThickness="0,1,0,0" />
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:SaleLine">
                                        <Button Background="Transparent" BorderThickness="0" Padding="0"
                                                CornerRadius="0" HorizontalAlignment="Stretch"
                                                HorizontalContentAlignment="Stretch"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectLineCommand}"
                                                CommandParameter="{Binding}">
                                            <Border BorderThickness="1"
                                                    BorderBrush="{Binding IsSelected, Converter={x:Static vm:Converters.SelectedLineBrush}}"
                                                    Padding="10,3,10,4">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold" />
                                                        <TextBlock Text="{Binding AysAmount}" FontSize="16" FontWeight="Bold"
                                                                   HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Product.Sku}" FontSize="13.5"
                                                               Margin="128,1,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Tender lines (Complete stage) -->
                            <ItemsControl ItemsSource="{Binding Payments}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:Payment">
                                        <StackPanel Margin="10,2,10,0">
                                            <Border BorderBrush="#55534A" BorderThickness="0,1,0,0"
                                                    Margin="-10,0,-10,3" />
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold" />
                                                <TextBlock Text="{Binding AysAmount}" FontSize="16" FontWeight="Bold"
                                                           HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <!-- Bottom: purch items / coupons + totals -->
                        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel Grid.Column="0" Margin="10,0,0,0" Spacing="4"
                                        VerticalAlignment="Top">
                                <Border BorderBrush="#55534A" BorderThickness="0,1,0,0"
                                        Margin="-10,0,0,4" />
                                <TextBlock Text="{Binding PurchItemsLabel}" FontSize="15.5" />
                                <TextBlock Text="{Binding CouponsLabel}" FontSize="15.5"
                                           IsVisible="{Binding ShowCoupons}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="0,4,14,0" Spacing="3"
                                        IsVisible="{Binding ShowTotals}">
                                <Grid ColumnDefinitions="150,110">
                                    <TextBlock Text="Subtotal:" FontSize="15.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="15.5"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid ColumnDefinitions="150,110">
                                    <TextBlock Text="Tax:" FontSize="15.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding TaxDisplay}" FontSize="15.5"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid ColumnDefinitions="150,110">
                                    <TextBlock Text="Total:" FontSize="15.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding TotalDisplay}" FontSize="15.5"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                                <Grid ColumnDefinitions="150,110">
                                    <TextBlock Text="Amount Due:" FontSize="15.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding AmountDueDisplay}" FontSize="15.5"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                            <!-- Complete stage shows just the subtotal -->
                            <StackPanel Grid.Column="1" Margin="0,4,14,0"
                                        IsVisible="{Binding IsCompleteStage}">
                                <Grid ColumnDefinitions="150,110">
                                    <TextBlock Text="Subtotal:" FontSize="15.5" FontWeight="Bold"
                                               HorizontalAlignment="Right" />
                                    <TextBlock Grid.Column="1" Text="{Binding SubtotalDisplay}" FontSize="15.5"
                                               FontWeight="Bold" HorizontalAlignment="Right" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Panel>
            </Border>

            <!-- ..... Right panel: prompts ..... -->
            <Border Grid.Column="1" Background="#F9F7DF" BorderBrush="#55534A" BorderThickness="0,1,1,1">
                <DockPanel Margin="12,8,12,8">

                    <!-- Bottom F-key legends -->
                    <StackPanel DockPanel.Dock="Bottom" Spacing="2">
                        <DockPanel IsVisible="{Binding IsLoyaltyStage}">
                            <TextBlock Classes="legend" Text="F6&#160;&#160;- Bypass" />
                            <TextBlock Classes="legend" Text="F3&#160;&#160;- Cancel Transaction"
                                       HorizontalAlignment="Right" />
                        </DockPanel>
                        <StackPanel IsVisible="{Binding IsScanStage}" Spacing="2">
                            <TextBlock Classes="legend" Text="F3&#160;&#160;&#160;&#160;&#160;&#160;- Cancel Transaction" />
                            <TextBlock Classes="legend" Text="Delete&#160;- Delete Selected Item" />
                            <TextBlock Classes="legend" IsVisible="{Binding HasItems}"
                                       Text="F8&#160;&#160;&#160;&#160;&#160;&#160;- Suspend Transaction" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsTenderSelectStage}" Spacing="2">
                            <TextBlock Classes="legend" Text="F3&#160;&#160;&#160;&#160;- Cancel Transaction" />
                            <TextBlock Classes="legend" Text="Esc&#160;&#160;- Return to Merchandise Section" />
                            <TextBlock Classes="legend" Text="F8&#160;&#160;&#160;&#160;- Suspend Transaction" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsCashStage}" Spacing="2">
                            <TextBlock Classes="legend" Text="F3&#160;&#160;&#160;- Cancel Transaction" />
                            <TextBlock Classes="legend" Text="Esc&#160;- Change Form of Payment" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding IsCardStage}" Spacing="2">
                            <TextBlock Classes="legend" Text="Esc&#160;- Change Form of Payment" />
                            <TextBlock Classes="legend" Text="F3&#160;&#160;&#160;- Cancel Transaction" />
                        </StackPanel>
                        <TextBlock Classes="legend" IsVisible="{Binding IsSignatureStage}"
                                   Text="F3&#160;- Cancel Transaction" />
                    </StackPanel>

                    <!-- Stage prompts -->
                    <Panel>

                        <!-- Loyalty -->
                        <StackPanel IsVisible="{Binding IsLoyaltyStage}" Spacing="14">
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>Ask customer to</Run> <Run FontWeight="Bold">Insert</Run>
                                <Run>or</Run> <Run FontWeight="Bold">Slide Bloomingdale's Card</Run>
                                <Run>or present</Run> <Run FontWeight="Bold">Bloomingdale's Pay barcode</Run>
                                <Run>in the Bloomingdale's app on their mobile device or present their</Run>
                                <Run FontWeight="Bold">Loyallist Key Tag</Run><Run>.</Run>
                            </TextBlock>
                            <StackPanel Spacing="6">
                                <TextBlock Classes="prompt advise" Text="Advise customer this is their opportunity to:" />
                                <TextBlock Classes="prompt" Text="•  View available offers" Margin="26,0,0,0"
                                           FontWeight="Bold" />
                            </StackPanel>
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>If card is unreadable, please press</Run> <Run FontWeight="Bold">T8</Run>
                                <Run>to key-in at the</Run> <Run FontWeight="Bold">Signature Pad</Run>
                            </TextBlock>
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>Press</Run> <Run FontWeight="Bold">T2</Run>
                                <Run>to Enroll the customer in the Loyallist program.</Run>
                            </TextBlock>
                            <TextBlock Classes="prompt" TextWrapping="Wrap" Foreground="#4E6E00"
                                       FontWeight="Bold" Margin="0,10,0,0">
                                <Run>NOTE: T7 Pay By Link will put the register into Send Merchandise mode</Run>
                            </TextBlock>
                        </StackPanel>

                        <!-- Scan -->
                        <StackPanel IsVisible="{Binding IsScanStage}" Spacing="14">
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run FontWeight="Bold">Scan</Run> <Run>merchandise or coupons.</Run>
                            </TextBlock>
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>If unreadable, input UPC or Dept/CI and press</Run>
                                <Run FontWeight="Bold">Enter</Run><Run>.</Run>
                            </TextBlock>
                            <Border Background="#A6D9C3" BorderBrush="#7FB8A4" BorderThickness="1"
                                    Width="330" Height="24" HorizontalAlignment="Left" Margin="0,14,0,0">
                                <TextBlock Text="{Binding ScanEntryDisplay}" FontSize="15"
                                           VerticalAlignment="Center" Margin="6,0" />
                            </Border>
                        </StackPanel>

                        <!-- Checkout / More payment methods -->
                        <StackPanel IsVisible="{Binding IsTenderSelectStage}" Spacing="16">
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>Press</Run> <Run FontWeight="Bold">T1</Run> <Run>for</Run>
                                <Run FontWeight="Bold">Bloomingdale's Card / Bloomingdale's Pay</Run>
                                <Run>or press</Run> <Run FontWeight="Bold">T8</Run> <Run>to view</Run>
                                <Run FontWeight="Bold">More Payment Methods</Run><Run>.</Run>
                            </TextBlock>
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>Remind customer that they will</Run>
                                <Run FontWeight="Bold">earn more points</Run>
                                <Run>and benefits by using their</Run>
                                <Run FontWeight="Bold">Bloomingdale's Card</Run><Run>!</Run>
                            </TextBlock>
                        </StackPanel>

                        <!-- Cash -->
                        <StackPanel IsVisible="{Binding IsCashStage}" Spacing="14">
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>Input cash amount and press</Run>
                                <Run FontWeight="Bold">Enter</Run><Run>.</Run>
                            </TextBlock>
                            <StackPanel Orientation="Horizontal" Spacing="4" Margin="130,50,0,0">
                                <TextBlock Text="$" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                                <Border Background="#FDFCF5" BorderBrush="#55534A" BorderThickness="1"
                                        Width="230" Height="24">
                                    <TextBlock Text="{Binding CashEntryDisplay}" FontSize="15"
                                               HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Margin="0,0,6,0" />
                                </Border>
                            </StackPanel>
                        </StackPanel>

                        <!-- Card / Bloomingdale's Pay at the customer terminal -->
                        <StackPanel IsVisible="{Binding IsCardStage}" Spacing="16">
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>Have customer</Run> <Run FontWeight="Bold">Insert</Run>
                                <Run>or</Run> <Run FontWeight="Bold">Slide Bloomingdale's Card</Run>
                                <Run>at the Signature Pad OR present</Run>
                                <Run FontWeight="Bold">Bloomingdale's Pay barcode</Run>
                                <Run>in the Bloomingdale's app on their mobile device.</Run>
                            </TextBlock>
                            <TextBlock Classes="prompt" TextWrapping="Wrap">
                                <Run>If card is unreadable, please press</Run> <Run FontWeight="Bold">T8</Run>
                                <Run>to key-in at the</Run> <Run FontWeight="Bold">Signature Pad</Run>
                            </TextBlock>
                        </StackPanel>

                        <!-- Signature wait -->
                        <StackPanel IsVisible="{Binding IsSignatureStage}" Spacing="30">
                            <TextBlock Classes="prompt" Text="Waiting for customer to sign..." />
                            <TextBlock Classes="prompt" TextWrapping="Wrap" Margin="40,20,0,0"
                                       Text="{Binding SignatureCountdownText}" />
                        </StackPanel>

                        <!-- Complete -->
                        <TextBlock IsVisible="{Binding IsCompleteStage}"
                                   Text="Updating Loyallist Program" FontSize="17" FontWeight="Bold"
                                   HorizontalAlignment="Center" Margin="0,180,0,0" />
                    </Panel>
                </DockPanel>
            </Border>

            <!-- "Purchase Completed" banner across the panels -->
            <Border Grid.ColumnSpan="2" IsVisible="{Binding IsCompleteStage}"
                    Background="#F2DCB4" BorderBrush="#8A8064" BorderThickness="1"
                    Width="700" Height="80" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Margin="0,120,0,0">
                <TextBlock Text="Purchase Completed" FontSize="18" FontWeight="Bold"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </Grid>

        <!-- ===== T1–T8 key grid ===== -->
        <ItemsControl Grid.Row="2" ItemsSource="{Binding TKeys}" Margin="8,2,8,2">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="4" Rows="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TKey">
                    <Button Classes="tkey" Margin="5,4"
                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).PressTKeyCommand}"
                            CommandParameter="{Binding}">
                        <Border Margin="3" BorderThickness="1"
                                BorderBrush="{Binding IsEnabled, Converter={x:Static vm:Converters.TKeyOutlineBrush}}">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="12,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{Binding Prefix}" FontSize="17" FontWeight="Bold"
                                           VerticalAlignment="Center"
                                           Foreground="{Binding IsEnabled, Converter={x:Static vm:Converters.TKeyTextBrush}}" />
                                <TextBlock Text="{Binding Label}" FontSize="16" FontWeight="Bold"
                                           TextWrapping="Wrap" MaxWidth="270" VerticalAlignment="Center"
                                           Foreground="{Binding IsEnabled, Converter={x:Static vm:Converters.TKeyTextBrush}}" />
                            </StackPanel>
                        </Border>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ===== Function bar ===== -->
        <Border Grid.Row="3" Background="#CFCAB6" BorderBrush="#8A867A" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" Spacing="8" Margin="10,0"
                        VerticalAlignment="Center">
                <Button Classes="fkey" Content="Back" Command="{Binding EscapeCommand}"
                        ToolTip.Tip="Step back one screen (Esc)" />
                <Button Classes="fkey" Content="Cancel Transaction"
                        Command="{Binding CancelTransactionCommand}"
                        ToolTip.Tip="Void the whole sale and start over (F3)" />
                <Button Classes="fkey" Content="Bypass Loyalty" Command="{Binding BypassCommand}"
                        IsVisible="{Binding IsLoyaltyStage}"
                        ToolTip.Tip="Skip the loyalty prompt (F6)" />
                <Button Classes="fkey" Content="Void Line" Command="{Binding DeleteLineCommand}"
                        IsVisible="{Binding IsScanStage}"
                        ToolTip.Tip="Remove the selected line (Delete)" />
                <Button Classes="fkey" Content="Suspend" Command="{Binding SuspendCommand}"
                        ToolTip.Tip="Suspend the transaction (F8)" />
                <Button Classes="fkey" Content="New Sale" Command="{Binding NewSaleCommand}" />

                <Border Width="1" Height="20" Background="#8A867A" Margin="6,0" />

                <Button Classes="fkey" Content="Items" Command="{Binding OpenItemsCommand}"
                        ToolTip.Tip="Tap-to-add items page" />
                <Button Classes="fkey" Content="Terminal Setup" Command="{Binding OpenSetupCommand}"
                        ToolTip.Tip="Payment terminal connection (F9)" />
            </StackPanel>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border Grid.Row="4" Background="#D9D4C0" BorderBrush="#8A867A" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto,Auto" Margin="6,2">
                <StackPanel Grid.Column="0" Margin="0,0,26,0">
                    <TextBlock Text="72027959" FontSize="11.5" />
                    <TextBlock Text="PS200" FontSize="11.5" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Open" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,40,0" />
                <TextBlock Grid.Column="2" Text="{Binding Status}" FontSize="12"
                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="3" Text="Normal" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,40,0" />
                <StackPanel Grid.Column="4" Margin="0,0,32,0" HorizontalAlignment="Center">
                    <TextBlock Text="AYS Register" FontSize="11.5" HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OnlineLabel}" FontSize="11.5" HorizontalAlignment="Center" />
                </StackPanel>
                <TextBlock Grid.Column="5" Text="ISP A" FontSize="12" VerticalAlignment="Center"
                           Margin="0,0,32,0" />
                <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="16"
                            VerticalAlignment="Center" Margin="0,0,8,0">
                    <TextBlock Text="{Binding DateText}" FontSize="12" />
                    <TextBlock Text="{Binding TimeText}" FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
