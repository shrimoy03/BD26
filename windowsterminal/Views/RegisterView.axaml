<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MerchantTerminal.ViewModels"
             xmlns:m="using:MerchantTerminal.Models"
             x:Class="MerchantTerminal.Views.RegisterView"
             x:DataType="vm:MainViewModel">

    <Grid RowDefinitions="70,54,*">

        <!-- ===== Register header ===== -->
        <Border Grid.Row="0" Background="{DynamicResource Panel}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center" Spacing="7">
                    <Panel Height="26" HorizontalAlignment="Left">
                        <Image Source="avares://MerchantTerminal/Assets/bloomingdales_wordmark.png"
                               Height="26" Stretch="Uniform"
                               IsVisible="{Binding !IsDarkTheme}" />
                        <Image Source="avares://MerchantTerminal/Assets/bloomingdales_wordmark_white.png"
                               Height="26" Stretch="Uniform"
                               IsVisible="{Binding IsDarkTheme}" />
                    </Panel>
                    <TextBlock Classes="label" Text="59TH STREET" LetterSpacing="3.2" />
                </StackPanel>

                <Border DockPanel.Dock="Left" Width="1" Height="34" Background="{DynamicResource Line}"
                        Margin="28,0,28,0" VerticalAlignment="Center" />

                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="26" VerticalAlignment="Center">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="STORE" Opacity="0.75" />
                        <TextBlock Text="0142 · Flagship" FontSize="12.5" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="REGISTER" Opacity="0.75" />
                        <TextBlock Text="POS-07 · L3 Fine Jewelry" FontSize="12.5" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="ASSOCIATE" Opacity="0.75" />
                        <TextBlock Text="D. Okonkwo · 44182" FontSize="12.5" FontWeight="Medium" />
                    </StackPanel>
                    <StackPanel Spacing="3">
                        <TextBlock Classes="label" Text="TRANSACTION" Opacity="0.75" />
                        <TextBlock Text="{Binding TxnId}" FontSize="12.5" FontWeight="Medium" />
                    </StackPanel>
                </StackPanel>

                <Button DockPanel.Dock="Right" Classes="pos" Height="36" Padding="14,0"
                        VerticalAlignment="Center" Command="{Binding ToggleThemeCommand}">
                    <TextBlock Text="{Binding ThemeLabel}" FontSize="11" LetterSpacing="1.3"
                               Foreground="{DynamicResource Dim}" />
                </Button>

                <TextBlock DockPanel.Dock="Right" Classes="mono dim" Text="{Binding ClockText}"
                           FontSize="14" VerticalAlignment="Center" Margin="0,0,28,0" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8"
                            VerticalAlignment="Center" Margin="0,0,28,0">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource Pos}" VerticalAlignment="Center" />
                    <TextBlock Text="Online" FontSize="12" Foreground="{DynamicResource Pos}" />
                </StackPanel>

                <Panel />
            </DockPanel>
        </Border>

        <!-- ===== Entry / status bar ===== -->
        <Border Grid.Row="1" Background="{DynamicResource Panel2}"
                BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1">
            <DockPanel Margin="24,0" VerticalAlignment="Center">
                <TextBlock DockPanel.Dock="Left" Classes="mono" Text="SCAN / SKU" FontSize="12"
                           LetterSpacing="1.7" Foreground="{DynamicResource Accent}"
                           VerticalAlignment="Center" Margin="0,0,14,0" />
                <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontSize="12"
                           Foreground="{DynamicResource Dim}" VerticalAlignment="Center" Margin="14,0,0,0" />
                <Border Height="34" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="6">
                    <TextBlock Classes="mono" Text="{Binding EntryDisplay}" FontSize="14"
                               VerticalAlignment="Center" Margin="12,0" />
                </Border>
            </DockPanel>
        </Border>

        <!-- ===== Basket + right rail ===== -->
        <Grid Grid.Row="2" ColumnDefinitions="*,452">

            <!-- Basket column -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto">
                <Border Grid.Row="0" Background="{DynamicResource Bg}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,0,1,0">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Column header -->
                        <Border Grid.Row="0" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                Padding="24,12">
                            <Grid ColumnDefinitions="56,12,*,12,120,12,70,12,130">
                                <TextBlock Grid.Column="0" Classes="label" Text="LINE" LetterSpacing="1.7" />
                                <TextBlock Grid.Column="2" Classes="label" Text="ITEM" LetterSpacing="1.7" />
                                <TextBlock Grid.Column="4" Classes="label" Text="PRICE" LetterSpacing="1.7" HorizontalAlignment="Right" />
                                <TextBlock Grid.Column="6" Classes="label" Text="QTY" LetterSpacing="1.7" HorizontalAlignment="Center" />
                                <TextBlock Grid.Column="8" Classes="label" Text="AMOUNT" LetterSpacing="1.7" HorizontalAlignment="Right" />
                            </Grid>
                        </Border>

                        <!-- Empty state -->
                        <StackPanel Grid.Row="1" IsVisible="{Binding IsEmpty}" Spacing="10"
                                    HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Classes="serif" Text="Begin a sale" FontSize="30"
                                       HorizontalAlignment="Center" />
                            <TextBlock Text="Scan an item, or use the quick keys below" FontSize="13"
                                       Foreground="{DynamicResource Dim}" HorizontalAlignment="Center" />
                        </StackPanel>

                        <!-- Lines -->
                        <ScrollViewer Grid.Row="1" IsVisible="{Binding IsNotEmpty}">
                            <ItemsControl ItemsSource="{Binding Lines}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:SaleLine">
                                        <Button Classes="row" Classes.selected="{Binding IsSelected}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).SelectLineCommand}"
                                                CommandParameter="{Binding}">
                                            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                                                    Padding="24,14">
                                                <Grid ColumnDefinitions="56,12,*,12,120,12,70,12,130">
                                                    <TextBlock Grid.Column="0" Classes="mono dim" Text="{Binding Num}"
                                                               FontSize="13" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Medium" />
                                                        <TextBlock Classes="mono dim" Text="{Binding Meta}" FontSize="11.5" />
                                                        <Border IsVisible="{Binding HasPromo}" HorizontalAlignment="Left"
                                                                BorderBrush="{DynamicResource Accent}" BorderThickness="1"
                                                                CornerRadius="4" Padding="7,3">
                                                            <TextBlock Text="{Binding Promo}" FontSize="10.5" LetterSpacing="1"
                                                                       Foreground="{DynamicResource Accent}" />
                                                        </Border>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="4" Classes="mono dim" Text="{Binding PriceDisplay}"
                                                               FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6"
                                                                HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <Button Classes="pos stepper" Content="–"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).DecrementQtyCommand}"
                                                                CommandParameter="{Binding}" />
                                                        <TextBlock Classes="mono" Text="{Binding Quantity}" FontSize="15"
                                                                   MinWidth="18" TextAlignment="Center" VerticalAlignment="Center" />
                                                        <Button Classes="pos stepper" Content="+"
                                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).IncrementQtyCommand}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="8" Classes="mono" Text="{Binding AmountDisplay}"
                                                               FontSize="16" FontWeight="Medium"
                                                               HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                </Grid>
                                            </Border>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <!-- Quick keys tray -->
                <Border Grid.Row="1" Background="{DynamicResource Panel}"
                        BorderBrush="{DynamicResource Line}" BorderThickness="0,1,1,0"
                        Padding="24,16,24,20">
                    <StackPanel Spacing="12">
                        <DockPanel LastChildFill="False">
                            <TextBlock DockPanel.Dock="Left" Classes="label" Text="QUICK KEYS · LEVEL 3" LetterSpacing="1.7" />
                            <TextBlock DockPanel.Dock="Right" Text="{Binding LineCountLabel}" FontSize="11.5"
                                       Foreground="{DynamicResource Dim}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding QuickKeys}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="5" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="m:Product">
                                    <Button Classes="pos key" Height="78" Margin="0,0,10,0"
                                            Padding="11" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch"
                                            Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).AddItemCommand}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Top" Text="{Binding Name}" FontSize="13"
                                                       FontWeight="Medium" LineHeight="16" TextWrapping="Wrap" />
                                            <TextBlock Classes="mono dim" Text="{Binding PriceDisplay}" FontSize="12"
                                                       VerticalAlignment="Bottom" />
                                        </DockPanel>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Right rail -->
            <Border Grid.Column="1" Background="{DynamicResource Panel}">
                <Grid RowDefinitions="Auto,Auto,*,Auto">

                    <!-- Customer strip -->
                    <Button Grid.Row="0" Classes="row" Command="{Binding OpenCustomerCommand}">
                        <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="20,16">
                            <DockPanel>
                                <Border DockPanel.Dock="Left" Width="42" Height="42" CornerRadius="21"
                                        BorderBrush="{DynamicResource Accent}" BorderThickness="1" Margin="0,0,14,0">
                                    <TextBlock Classes="serif" Text="{Binding CustomerInitials}" FontSize="18"
                                               Foreground="{DynamicResource Accent}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding CustomerAction}" FontSize="11"
                                           LetterSpacing="1.3" Foreground="{DynamicResource Accent}"
                                           VerticalAlignment="Center" />
                                <StackPanel Spacing="4" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CustomerName}" FontSize="15" FontWeight="Medium" />
                                    <TextBlock Text="{Binding CustomerMeta}" FontSize="11.5"
                                               Foreground="{DynamicResource Dim}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Button>

                    <!-- Totals -->
                    <Border Grid.Row="1" BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1"
                            Padding="20,20,20,18">
                        <StackPanel Spacing="11">
                            <DockPanel>
                                <TextBlock Text="Subtotal" FontSize="14" Foreground="{DynamicResource Dim}" />
                                <TextBlock Classes="mono" Text="{Binding SubtotalDisplay}" FontSize="14"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="{Binding DiscountLabel}" FontSize="14" Foreground="{DynamicResource Dim}" />
                                <TextBlock Classes="mono" Text="{Binding DiscountDisplay}" FontSize="14"
                                           Foreground="{DynamicResource Accent}" HorizontalAlignment="Right" />
                            </DockPanel>
                            <DockPanel>
                                <TextBlock Text="Sales tax · 8.875%" FontSize="14" Foreground="{DynamicResource Dim}" />
                                <TextBlock Classes="mono" Text="{Binding TaxDisplay}" FontSize="14"
                                           HorizontalAlignment="Right" />
                            </DockPanel>
                            <Border Height="1" Background="{DynamicResource Line}" Margin="0,3" />
                            <DockPanel>
                                <TextBlock Text="TOTAL DUE" Classes="label" FontSize="11" LetterSpacing="2"
                                           VerticalAlignment="Bottom" Margin="0,0,0,6" />
                                <TextBlock Classes="mono" Text="{Binding TotalDisplay}" FontSize="34"
                                           FontWeight="SemiBold" LetterSpacing="-0.7" HorizontalAlignment="Right" />
                            </DockPanel>
                            <StackPanel Spacing="8" Margin="0,6,0,0" IsVisible="{Binding HasPaid}">
                                <ItemsControl ItemsSource="{Binding Payments}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Spacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="m:Payment">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Label}" FontSize="13"
                                                           Foreground="{DynamicResource Pos}" />
                                                <TextBlock Classes="mono" Text="{Binding AmountDisplay}" FontSize="13"
                                                           Foreground="{DynamicResource Pos}" HorizontalAlignment="Right" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <DockPanel>
                                    <TextBlock Text="Balance" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock Classes="mono" Text="{Binding BalanceDisplay}" FontSize="14"
                                               FontWeight="SemiBold" HorizontalAlignment="Right" />
                                </DockPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Function pad -->
                    <Grid Grid.Row="2" Margin="20,18"
                          ColumnDefinitions="*,10,*" RowDefinitions="64,10,64,10,64,10,64"
                          VerticalAlignment="Top">
                        <Button Grid.Row="0" Grid.Column="0" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ItemSearchCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Item search" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Catalogue · F2" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="0" Grid.Column="2" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding OpenPromosCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Promotions" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="{Binding PromoHint}" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="0" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding OpenCustomerCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Customer" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="{Binding CustomerHint}" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="2" Grid.Column="2" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding PriceOverrideCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Price override" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Manager · F6" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="4" Grid.Column="0" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding GiftOptionsCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Gift options" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Box, wrap, message" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="4" Grid.Column="2" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding ShipFromStoreCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Ship from store" FontSize="14" FontWeight="Medium" />
                                <TextBlock Text="Endless aisle" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="6" Grid.Column="0" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding VoidLineCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Void line" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource Danger}" />
                                <TextBlock Text="Removes selection" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Row="6" Grid.Column="2" Classes="pos key" Padding="14,0"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding SuspendSaleCommand}">
                            <StackPanel Spacing="4" VerticalAlignment="Center">
                                <TextBlock Text="Suspend sale" FontSize="14" FontWeight="Medium"
                                           Foreground="{DynamicResource Dim}" />
                                <TextBlock Text="Recall at any till" FontSize="10.5" LetterSpacing="0.6"
                                           Foreground="{DynamicResource Dim}" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Tender CTA -->
                    <Button Grid.Row="3" Classes="cta" Height="74" Margin="20,0,20,20"
                            Padding="24,0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                            Command="{Binding OpenTenderCommand}">
                        <DockPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding TenderLabel}" FontSize="19" FontWeight="SemiBold"
                                       LetterSpacing="0.8" VerticalAlignment="Center" />
                            <TextBlock Classes="mono" Text="{Binding BalanceDisplay}" FontSize="19"
                                       FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                        </DockPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
