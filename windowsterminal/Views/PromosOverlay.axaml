<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MerchantTerminal.ViewModels"
             x:Class="MerchantTerminal.Views.PromosOverlay"
             x:DataType="vm:MainViewModel">

    <Panel Background="{StaticResource Scrim}">
        <Button Classes="scrim" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                Command="{Binding CloseOverlayCommand}" />

        <Border Width="760" HorizontalAlignment="Center" VerticalAlignment="Center"
                Background="{DynamicResource Panel}" BorderBrush="{DynamicResource Line}"
                BorderThickness="1" CornerRadius="16" ClipToBounds="True"
                BoxShadow="0 18 44 0 #73000000">
            <StackPanel>
                <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,0,0,1" Padding="26,22">
                    <DockPanel>
                        <TextBlock Classes="serif" Text="Promotions &amp; discounts" FontSize="26" />
                        <TextBlock Text="{Binding PromoScope}" FontSize="12" Foreground="{DynamicResource Dim}"
                                   HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,0,4" />
                    </DockPanel>
                </Border>

                <ScrollViewer MaxHeight="440">
                    <ItemsControl ItemsSource="{Binding Promos}" Margin="26,18">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Spacing="10" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:PromoRow">
                                <Button Classes="promo-row" Classes.applied="{Binding IsApplied}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).TogglePromoCommand}"
                                        CommandParameter="{Binding}">
                                    <DockPanel>
                                        <StackPanel DockPanel.Dock="Right" Width="88" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding State}" FontSize="11" LetterSpacing="1.3"
                                                       HorizontalAlignment="Right"
                                                       Classes.state-apply="{Binding !IsApplied}"
                                                       Classes.state-applied="{Binding IsApplied}"
                                                       Classes.state-blocked="{Binding IsBlocked}" />
                                        </StackPanel>
                                        <TextBlock DockPanel.Dock="Right" Classes="mono" Text="{Binding ValueDisplay}"
                                                   FontSize="15" Foreground="{DynamicResource Accent}"
                                                   VerticalAlignment="Center" Margin="18,0" />
                                        <StackPanel Spacing="5" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Medium" />
                                            <TextBlock Text="{Binding Terms}" FontSize="12"
                                                       Foreground="{DynamicResource Dim}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="26,16">
                    <Button Classes="cta" Height="44" Padding="26,0" CornerRadius="8"
                            Command="{Binding CloseOverlayCommand}">
                        <TextBlock Text="Done" FontSize="14" FontWeight="SemiBold" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Border>
    </Panel>
</UserControl>
