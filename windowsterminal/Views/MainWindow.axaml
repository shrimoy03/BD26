<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MerchantTerminal.ViewModels"
        xmlns:v="using:MerchantTerminal.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1600" d:DesignHeight="1000"
        x:Class="MerchantTerminal.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Width="1280" Height="800"
        Background="#C9C4B2"
        FontFamily="{StaticResource Sans}"
        Title="Bloomingdale's POS">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- AYS register keys: F3 cancel txn, F6 bypass loyalty, F8 suspend,
         Esc step back, Delete void line. F9 opens the terminal setup screen. -->
    <Window.KeyBindings>
        <KeyBinding Gesture="F3" Command="{Binding CancelTransactionCommand}" />
        <KeyBinding Gesture="F6" Command="{Binding BypassCommand}" />
        <KeyBinding Gesture="F8" Command="{Binding SuspendCommand}" />
        <KeyBinding Gesture="F9" Command="{Binding OpenSetupCommand}" />
        <KeyBinding Gesture="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding DeleteLineCommand}" />
    </Window.KeyBindings>

    <Viewbox Stretch="Uniform">
        <Panel x:Name="RootCanvas" Width="1600" Height="1000" Background="#C9C4B2">
            <v:RegisterView />
            <v:SetupOverlay IsVisible="{Binding ShowSetup}" />
        </Panel>
    </Viewbox>
</Window>
