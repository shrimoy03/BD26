<?xml version="1.0" encoding="utf-8"?>
<!--
  Idle landing page. The biometric tender is chosen on the PxRetailer form /
  merchant register, which foregrounds this app straight into capture — so
  there are no buttons here, just the Bloomingdale's wordmark. A subtle
  settings affordance and an invisible status line remain for config/errors.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/white">

    <!-- Large, centered wordmark -->
    <ImageView
        android:id="@+id/brandLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:paddingHorizontal="120dp"
        android:contentDescription="@string/wordmark"
        android:src="@drawable/bloomingdales_wordmark" />

    <!-- Error/status line under the logo; invisible until needed -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="72dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:textColor="#B00020"
        android:textSize="14sp"
        android:visibility="invisible" />

    <!-- Subtle settings access, top-right -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:alpha="0.35"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="6dp"
        android:src="@drawable/ic_settings" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/powered_by"
        android:src="@drawable/powered_by_wink" />
</FrameLayout>
