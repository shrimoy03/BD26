<?xml version="1.0" encoding="utf-8"?>
<!--
  Idle landing page, styled after the PAX welcome reference: "Welcome to" +
  the wordmark upper-left, card art overlapping at the bottom-right. The
  biometric tender is chosen on the PxRetailer form / merchant register, so
  there are no buttons here. A subtle settings affordance and an invisible
  status line remain for config/errors; long-press the wordmark for a bench
  face check-in.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:keepScreenOn="true"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="start|top"
        android:layout_marginStart="90dp"
        android:layout_marginTop="110dp"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:text="@string/welcome_to"
            android:textColor="@color/text_dark"
            android:textSize="30sp" />

        <ImageView
            android:id="@+id/brandLogo"
            android:layout_width="520dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/wordmark"
            android:scaleType="fitStart"
            android:src="@drawable/bloomingdales_wordmark" />
    </LinearLayout>

    <!-- Overlapping card art, bottom-right -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="46dp"
        android:layout_marginBottom="40dp">

        <ImageView
            android:layout_width="230dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="80dp"
            android:layout_marginTop="66dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/card_brand_line"
            android:src="@drawable/loyallist_card" />

        <ImageView
            android:layout_width="270dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="60dp"
            android:adjustViewBounds="true"
            android:contentDescription="@string/card_brand_line"
            android:src="@drawable/totl_card_credit" />
    </FrameLayout>

    <!-- Failure recovery for register-driven scans: without this, a failed or
         backed-out capture strands the customer on the idle page while the
         register sits awaiting. Scrim swallows touches behind the card. -->
    <FrameLayout
        android:id="@+id/retryPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66000000"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="440dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@drawable/bg_panel"
            android:elevation="8dp"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="26dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/scan_retry_title"
                android:textColor="@color/text_dark"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/retryMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textColor="@color/text_dark"
                android:textSize="14sp" />

            <Button
                android:id="@+id/retryButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_btn_black"
                android:text="@string/try_again_button"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="17sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/retryCancelButton"
                style="@style/Widget.AppCompat.Button.Borderless"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:layout_marginTop="8dp"
                android:text="@string/cancel_sale"
                android:textAllCaps="false"
                android:textColor="@color/text_dark"
                android:textSize="15sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- Error/status line; invisible until needed -->
    <TextView
        android:id="@+id/statusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal|bottom"
        android:layout_marginBottom="14dp"
        android:gravity="center"
        android:paddingHorizontal="24dp"
        android:textColor="#B00020"
        android:textSize="14sp"
        android:visibility="invisible" />

    <!-- Subtle settings access, top-right -->
    <ImageView
        android:id="@+id/settingsButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_margin="16dp"
        android:alpha="0.35"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/settings"
        android:padding="6dp"
        android:src="@drawable/ic_settings" />

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="20dp"
        android:layout_gravity="bottom|start"
        android:layout_margin="16dp"
        android:adjustViewBounds="true"
        android:contentDescription="@string/powered_by"
        android:src="@drawable/powered_by_wink" />
</FrameLayout>
