<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.WinkPos" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/bloom_black</item>
        <item name="colorPrimaryVariant">@color/bloom_black</item>
        <item name="colorSecondary">@color/loyallist_purple</item>
        <item name="android:windowBackground">@color/white</item>
        <item name="android:statusBarColor">@color/bloom_black</item>
    </style>

    <style name="Wordmark">
        <item name="android:fontFamily">sans-serif-light</item>
        <item name="android:textColor">@color/text_dark</item>
        <item name="android:letterSpacing">0.08</item>
    </style>

    <style name="RedeemButton" parent="Widget.AppCompat.Button.Borderless">
        <item name="android:background">@drawable/bg_btn_black</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0.1</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">110dp</item>
        <item name="android:paddingLeft">18dp</item>
        <item name="android:paddingRight">18dp</item>
    </style>

    <style name="RedeemButton.Small">
        <item name="android:textSize">11sp</item>
        <item name="android:minHeight">32dp</item>
        <item name="android:minWidth">86dp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
    </style>
</resources>
